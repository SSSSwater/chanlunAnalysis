TUSHARE_TOKEN=
TUSHARE_HTTP_URL=https://jiaoch.top/

# Resend email sending. The actual .env file is ignored by Git.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Brevo fallback when Resend daily or monthly usage is exhausted.
BREVO_API_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
  BINANCE_CREDENTIAL_ENCRYPTION_KEY=

# Binance traffic must use the local xray HTTP proxy.  Keep REST and
# WebSocket endpoints explicit so a restart cannot silently fall back to a
# different proxy or attempt a direct connection.
BINANCE_REST_PROXY=http://127.0.0.1:10808
BINANCE_WS_PROXY=http://127.0.0.1:10808

# Smart Money header capture uses a local Chrome DevTools endpoint.
# Start Chrome with --remote-debugging-port=9222 when using the UI button.
BINANCE_BROWSER_CDP_URL=http://127.0.0.1:9222
