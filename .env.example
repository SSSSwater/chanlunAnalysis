# Optional: without a token, the app falls back to other market-data providers.
TUSHARE_TOKEN=
TUSHARE_HTTP_URL=https://jiaoch.top/

# Resend email sending. The actual .env file is ignored by Git.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Brevo fallback when Resend daily or monthly usage is exhausted.
BREVO_API_KEY=

# Fernet application key for encrypting stored Binance API credentials.
# Keep it stable across restarts and database migrations.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BINANCE_CREDENTIAL_ENCRYPTION_KEY=mhobAG4HDRUzwjAhZIJ_keTsGUxXUAXpmr4xvlfAGpM=

# Optional HTTP proxy URLs. Leave blank when no reachable proxy is needed.
BINANCE_REST_PROXY=
BINANCE_WS_PROXY=

# Local-only: Smart Money header capture uses a local Chrome DevTools endpoint.
BINANCE_BROWSER_CDP_URL=http://127.0.0.1:9222
